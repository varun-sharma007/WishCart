# Frontend (safe to expose only NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_SUPABASE_PUBLISHABLE_KEY_HERE

# API and Supabase Postgres
DATABASE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=PASTE_DATABASE_PASSWORD_HERE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated, exact frontend origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional extra outbound merchant hosts. Store URLs must always be HTTPS.
OUTBOUND_ALLOWED_HOSTS=amazon.in,flipkart.com
# Development-only bootstrap administrator. Use Supabase Auth in production.
WISHCART_ADMIN_EMAIL=admin@2026
WISHCART_ADMIN_PASSWORD=CHANGE_ME
WISHCART_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN

